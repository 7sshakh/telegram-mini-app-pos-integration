# ---------------------------------------------------------------------------
# VIBE — HotDog · Burger · Drinks | Telegram Mini App cloud service
# Copy to `.env` (local) or paste into your hosting provider's env settings.
# NEVER commit real secrets. NEVER put any of these values in client code.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Postgres connection for the CLOUD service (queue, sessions, customers mirror).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
NODE_ENV=production
# Public base URL of this deployment (used for payment webhooks + bot buttons).
APP_BASE_URL=http://localhost:3000

# --- Security ---------------------------------------------------------------
# 32+ random bytes. Signs customer session tokens.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-32-bytes-hex
# Admin token for /api/admin/* (POS owner only). Use a long random string.
ADMIN_API_TOKEN=change-me-admin-token
# Allow /api/dev/* mock endpoints. MUST be false in production.
DEV_MODE=false
# Accept Telegram initData without a bot token (DEV ONLY).
ALLOW_UNVERIFIED_INITDATA=false

# --- Telegram ---------------------------------------------------------------
# From @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=8795667893:AAFPtmx4kwN_njV1liQ-z3kxW2PddqirmIg
# Bot username without @ (for the Mini App button / direct links).
TELEGRAM_BOT_USERNAME=vibe_orders_bot
# Seconds a Telegram login is considered fresh (default 86400 = 24h).
TELEGRAM_AUTH_TTL=86400
# Announce order status changes through the bot (requires bot token).
TELEGRAM_NOTIFY=true

# --- POS bridge -------------------------------------------------------------
# mock  -> use bundled fake POS data (development only)
# pos   -> real VIBE Electron POS through the local agent
POS_MODE=pos
# Allow falling back to mock data when the POS is offline (dev/staging only).
ALLOW_MOCK_FALLBACK=false
# Seconds a cached POS catalog snapshot stays fresh.
CATALOG_TTL_SECONDS=90
# Long-poll window for the local agent (seconds).
BRIDGE_POLL_SECONDS=5
# How long a claimed-but-unacked job waits before being retried (seconds).
BRIDGE_JOB_LEASE_SECONDS=60
# Max delivery attempts before a job is marked dead.
BRIDGE_MAX_ATTEMPTS=30

# --- POS agent (runs on the POS computer, see /agent) -----------------------
# Cloud URL the agent talks to. MUST be the public Vercel URL.
AGENT_CLOUD_URL=https://vibe-pos.vercel.app
# Local POS adapter URL (Electron main process, bound to 127.0.0.1).
AGENT_POS_URL=http://127.0.0.1:8787
# Shared secret between the agent and the local POS adapter.
AGENT_POS_TOKEN=dev-local-pos-token
# Device identity issued by the admin registration endpoint.
AGENT_DEVICE_ID=
AGENT_DEVICE_SECRET=
AGENT_NAME=VIBE-POS-1

# --- Online payments (optional, provider agnostic) --------------------------
# Provider registry key. Built-in: "manual" (no online payment), "payme", "click", "stripe".
PAYMENT_PROVIDER=manual
# Provider specific credentials — read server side only.
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_WEBHOOK_SECRET=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
